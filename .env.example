# Какое приложение семьи запускаем (см. apps.config.ts)
NEXT_PUBLIC_APP_KEY=ball30uz

# Публичный адрес деплоя (нужен для настройки бота)
NEXT_PUBLIC_APP_URL=

# Токен бота из @BotFather — никогда не коммитить настоящее значение
TELEGRAM_BOT_TOKEN=

# Произвольная секретная строка собственного изобретения — Telegram будет
# присылать её в каждом запросе вебхука, так сервер проверяет, что запрос
# действительно от Telegram, а не от кого-то, кто угадал URL
TELEGRAM_WEBHOOK_SECRET=

# Supabase Postgres: pooled-строка для рантайма, прямая — для миграций Prisma
DATABASE_URL=
DIRECT_URL=
