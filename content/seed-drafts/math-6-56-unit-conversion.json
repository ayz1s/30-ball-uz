          },
          {
            "text": "Делим 180 на 60.",
            "explanation": "Секунда меньше минуты, поэтому минут получится меньше. 180 : 60 = 3."
          },
          {
            "text": "Ответ: 3 мин.",
            "explanation": "180 с = 3 мин."
          }
        ]
