          },
          {
            "question": "log₂₅ 125 = ?",
            "answer": "3/2, ведь 25 = 5², 125 = 5³, значит (3/2)·log₅ 5 = 3/2"
          },
          {
            "question": "Верно ли logₐ(x²) = 2·logₐ x при x < 0?",
            "answer": "Нет. При x < 0 левая часть определена, а правая — нет. Правильно: logₐ(x²) = 2·logₐ|x|."
          }
        ]
      }
