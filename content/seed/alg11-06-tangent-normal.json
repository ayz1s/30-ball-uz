      {
        "type": "steps",
        "condition": "Составить уравнение касательной к f(x) = 2eˣ в точке x₀ = 0.",
        "steps": [
          {
            "text": "f(0) = 2·e⁰ = 2.",
            "explanation": "e⁰ = 1, значит точка касания — (0; 2)."
          },
          {
            "text": "Производная: f′(x) = 2eˣ.",
            "explanation": "Производная eˣ равна самой себе, а двойка — постоянный множитель."
          },
          {
            "text": "f′(0) = 2·e⁰ = 2.",
            "explanation": "В точке x = 0 наклон касательной равен 2."
          },
          {
            "text": "Подставляем в формулу: y − 2 = 2·(x − 0).",
            "explanation": "x₀ = 0, поэтому (x − 0) = x."
          },
          {
            "text": "Ответ: y = 2x + 2.",
            "explanation": "Переносим −2 вправо: y = 2x + 2. Прямая проходит через (0; 2) с наклоном 2."
          }
        ]
      },
      {
        "type": "steps",
        "condition": "Составить уравнение касательной к f(x) = ln x в точке x₀ = e.",
        "steps": [
          {
            "text": "f(e) = ln e = 1.",
            "explanation": "Натуральный логарифм от e по определению равен 1. Точка касания — (e; 1)."
          },
          {
            "text": "Производная: f′(x) = 1/x.",
            "explanation": "Производная ln x — стандартная формула 1/x."
          },
          {
            "text": "f′(e) = 1/e.",
            "explanation": "Угловой коэффициент касательной в этой точке — дробь 1/e, то есть наклон пологий."
          },
          {
            "text": "Уравнение: y − 1 = (1/e)·(x − e).",
            "explanation": "Подставили x₀ = e, f(x₀) = 1, f′(x₀) = 1/e."
          },
          {
            "text": "Упростим: y = x/e.",
            "explanation": "Раскрываем: y = x/e − 1 + 1. Свободный член сокращается, прямая проходит через начало координат."
          }
        ]
      },
      {
        "type": "steps",
        "condition": "Составить уравнение касательной к f(x) = 2 sin x в точке x₀ = π/6.",
        "steps": [
          {
            "text": "f(π/6) = 2·sin(π/6) = 2·(1/2) = 1.",
            "explanation": "sin(π/6) = 1/2. Точка касания — (π/6; 1)."
          },
          {
            "text": "Производная: f′(x) = 2 cos x.",
            "explanation": "Производная sin x равна cos x, двойка остаётся."
          },
          {
            "text": "f′(π/6) = 2·cos(π/6) = 2·(√3/2) = √3.",
            "explanation": "cos(π/6) = √3/2. Наклон касательной равен √3 ≈ 1,732."
          },
          {
            "text": "Запишем уравнение: y − 1 = √3·(x − π/6).",
            "explanation": "Подставили все значения в общую формулу."
          },
          {
            "text": "Приведём к виду y = kx + b: y = √3·x + 1 − (√3·π)/6.",
            "explanation": "Переносим 1 вправо. Это окончательный ответ, где b = 1 − (√3·π)/6."
          }
        ]
      },
      {
        "type": "steps",
        "condition": "Найти sin α и cos α угла наклона касательной к f(x) = x³ в точке x₀ = 1.",
        "steps": [
          {
            "text": "Угловой коэффициент: f′(x) = 3x², f′(1) = 3.",
            "explanation": "По геометрическому смыслу производной tg α = 3."
          },
          {
            "text": "Найдём sin α по формуле: sin α = tg α / √(1 + tg²α) = 3 / √10.",
            "explanation": "Если tg α = 3, представим прямоугольный треугольник с катетами 3 и 1, гипотенуза √10. sin — отношение противолежащего катета к гипотенузе."
          },
          {
            "text": "Найдём cos α: cos α = 1 / √(1 + tg²α) = 1 / √10 = √10/10.",
            "explanation": "cos — отношение прилежащего катета к гипотенузе. Так как угол острый, оба значения положительны."
          },
          {
            "text": "Рационализуем: sin α = 3√10/10, cos α = √10/10.",
            "explanation": "Умножили числитель и знаменатель на √10, чтобы избавиться от иррациональности в знаменателе."
          }
        ]
      },
      {
        "type": "steps",
        "condition": "К графику f(x) = x² − 2x + 3 провести касательную, параллельную прямой y = 4x + 1.",
        "steps": [
          {
            "text": "У заданной прямой угловой коэффициент k = 4.",
            "explanation": "Уравнение y = 4x + 1 уже в стандартном виде, перед x стоит 4."
          },
          {
            "text": "Приравниваем производную к 4: f′(x) = 2x − 2 = 4.",
            "explanation": "При параллельности наклоны совпадают. Ищем, где график имеет такой же наклон."
          },
          {
            "text": "Решаем: 2x = 6 → x₀ = 3.",
            "explanation": "Это абсцисса точки касания."
          },
          {
            "text": "Найдём ординату: f(3) = 3² − 2·3 + 3 = 6.",
            "explanation": "Подставляем x = 3 в исходную функцию. Точка касания — (3; 6)."
          },
          {
            "text": "Составляем уравнение: y − 6 = 4·(x − 3) → y = 4x − 6.",
            "explanation": "Используем общую формулу с k = 4. После упрощения b = −6."
          }
        ]
      },
      {
        "type": "steps",
        "condition": "К графику f(x) = x² провести касательную, перпендикулярную прямой y = (1/2)x.",
        "steps": [
          {
            "text": "У заданной прямой k₁ = 1/2.",
            "explanation": "Коэффициент перед x равен 1/2."
          },
          {
            "text": "Для перпендикулярных прямых k₁·k₂ = −1, значит k₂ = −2.",
            "explanation": "Обратное к 1/2 — это 2, со знаком минус получаем −2."
