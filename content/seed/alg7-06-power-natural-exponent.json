          },
          {
            "text": "Числители перемножаем отдельно: 2 · 2 · 2 = 8.",
            "explanation": "Верхняя часть дроби — числитель."
          },
          {
            "text": "Знаменатели перемножаем отдельно: 5 · 5 · 5 = 125.",
            "explanation": "Нижняя часть дроби — знаменатель."
          },
          {
            "text": "Результат: 8/125.",
            "explanation": "Степень дроби — это степень числителя, делённая на степень знаменателя."
          }
        ]
      },
