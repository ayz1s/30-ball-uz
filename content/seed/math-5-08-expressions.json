          },
          {
            "text": "Подставим в формулу: P = 2·(6 + 4).",
            "explanation": "Формула периметра показывает, что сумму двух разных сторон нужно удвоить."
          },
          {
            "text": "Сложим в скобках: 6 + 4 = 10.",
            "explanation": "Действие в скобках выполняется первым."
          },
          {
            "text": "Умножим: 2·10 = 20.",
            "explanation": "Удвоим сумму сторон. Ответ: 20 см."
          }
